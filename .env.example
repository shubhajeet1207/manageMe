DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full"
AUTH_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Which storage driver serves uploaded resume bytes: "local", "r2", or "b2".
# An unknown value throws at startup rather than silently writing production
# resumes to a container's ephemeral disk.
#
# "local" CANNOT work on Vercel: a serverless filesystem is per-invocation, so
# bytes written during an upload are gone before the next request reads them.
STORAGE_DRIVER="local"
# Where the local driver keeps those bytes, resolved against the process's
# working directory. Gitignored, and deliberately outside public/ so nothing is
# statically served — files leave only through the authorising route.
UPLOADS_DIR=".uploads"

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Encrypts stored credential passwords (AES-256-GCM). NOT AUTH_SECRET — they
# have different lifecycles and different blast radii — and never derived from
# the database, because a key inside the dump makes the dump self-decrypting.
CREDENTIALS_KEY=""
# Optional. The previous CREDENTIALS_KEY, kept decrypt-only during a rotation
# so existing records stay readable until they are re-encrypted. Remove it once
# the "still encrypted with the previous key" count reaches zero.
CREDENTIALS_KEY_PREVIOUS=""

# --- Cloudflare R2 (required when STORAGE_DRIVER="r2") ---
# Requires a card on file to enable, even for free-tier usage. See B2 below
# for a card-free alternative that speaks the same S3-compatible API.
#
# The account id is the subdomain of your R2 S3 endpoint:
#   https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=""
# An R2 API token with Object Read & Write scoped to the ONE bucket below.
# Not an account-wide token: this key sits in a deploy environment, and its
# blast radius should stop at the bucket it needs.
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# --- Backblaze B2 (required when STORAGE_DRIVER="b2") ---
# No card required to sign up. S3-compatible, so it uses the same driver as
# R2 above with a different endpoint and region.
#
# B2_ENDPOINT is the bucket's "S3 compatible" endpoint shown on its page in
# the B2 dashboard — copy it verbatim rather than typing it by hand, e.g.:
#   https://s3.us-west-004.backblazeb2.com
# The region embedded in it is load-bearing: unlike R2, B2 is genuinely
# regional and a mismatched region fails every request's signature.
B2_ENDPOINT=""
# An "Application Key" scoped to the ONE bucket above (create it from the
# bucket's page, not the account-wide keys page).
B2_KEY_ID=""
B2_APPLICATION_KEY=""
B2_BUCKET=""
