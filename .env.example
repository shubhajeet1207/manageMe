DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full"
AUTH_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Which storage driver serves uploaded resume bytes. "local" is the only
# supported value today; an unknown one throws at startup rather than silently
# writing production resumes to a container's ephemeral disk.
STORAGE_DRIVER="local"
# Where the local driver keeps those bytes, resolved against the process's
# working directory. Gitignored, and deliberately outside public/ so nothing is
# statically served — files leave only through the authorising route.
UPLOADS_DIR=".uploads"
