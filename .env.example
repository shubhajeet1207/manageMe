DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full"
AUTH_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Which storage driver serves uploaded resume bytes. "local" is the only
# supported value today; an unknown one throws at startup rather than silently
# writing production resumes to a container's ephemeral disk.
STORAGE_DRIVER="local"
# Where the local driver keeps those bytes, resolved against the process's
# working directory. Gitignored, and deliberately outside public/ so nothing is
# statically served — files leave only through the authorising route.
UPLOADS_DIR=".uploads"

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Encrypts stored credential passwords (AES-256-GCM). NOT AUTH_SECRET — they
# have different lifecycles and different blast radii — and never derived from
# the database, because a key inside the dump makes the dump self-decrypting.
CREDENTIALS_KEY=""
# Optional. The previous CREDENTIALS_KEY, kept decrypt-only during a rotation
# so existing records stay readable until they are re-encrypted. Remove it once
# the "still encrypted with the previous key" count reaches zero.
CREDENTIALS_KEY_PREVIOUS=""
